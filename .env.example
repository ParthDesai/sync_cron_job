# Solana RPC endpoint
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# KV Database path (local file-based storage)
DATABASE_PATH=./kv_store

# Daily transaction limit
DAILY_TRANSACTION_LIMIT=100

# Cron schedule (every 15 minutes for random checks)
CRON_SCHEDULE=0 */15 * * * *

# Path to Solana keypair file
KEYPAIR_FILE=~/.config/solana/id.json

# Target Solana program ID
PROGRAM_ID=11111111111111111111111111111112

# Transaction commitment level
COMMITMENT=confirmed

# Base58-encoded instruction data (optional)
INSTRUCTION_DATA=

# Configuration file path (optional)
CONFIG_PATH=config.json 